# ───────────────────────────────────────────────────────────────────────────
# DocSwift — Environment Variables
# Copy this file to `.env.local` (dev) and set each value on Railway (prod).
# Generate strong secrets with:  openssl rand -base64 32
# ───────────────────────────────────────────────────────────────────────────

# ── NextAuth ───────────────────────────────────────────────────────────────
# In dev: http://localhost:3000
# In prod: https://getdocswift.com (or whatever your Railway domain is)
NEXTAUTH_URL=http://localhost:3000
# REQUIRED in prod — strong random secret (32+ chars)
NEXTAUTH_SECRET=

# ── Google OAuth (Sign in with Google) ────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase (database + auth backend) ────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NEVER expose client-side
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (subscriptions) ────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Prix régulier 9,99€/mois (créé automatiquement — prod_UnO7XpjIAXDQ1T)
STRIPE_PRICE_ID=price_1TnnLEHOgcCONmC6KVui17E1
# Prix promo 4,99€/mois (optionnel)
STRIPE_PRICE_ID_PROMO=price_1TnnLIHOgcCONmC6N8QqwnHL
# Webhook signing secret — get from Stripe dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Stripe HR (DocSwift HR — B2B subscriptions, isolated from the above) ──
# 3 Price IDs, one per recurring monthly plan — create in Stripe dashboard first
STRIPE_PRICE_HR_STARTER=
STRIPE_PRICE_HR_PRO=
STRIPE_PRICE_HR_BUSINESS=
# Signing secret for a SEPARATE webhook endpoint pointed at /api/webhooks/stripe
STRIPE_HR_WEBHOOK_SECRET=whsec_...

# ── Resend (transactional emails) ─────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified domain in Resend (e.g. noreply@getdocswift.com)
EMAIL_FROM=DocSwift <noreply@getdocswift.com>

# ── Gemini (AI features: chat, HR CV screening) ──────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────
# Email that has access to /admin
ADMIN_EMAIL=

# ── Google Search Console ─────────────────────────────────────────────────
# Get from https://search.google.com/search-console → Verify ownership → HTML tag
GOOGLE_SITE_VERIFICATION=
